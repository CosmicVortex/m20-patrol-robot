[Unit]
Description=M20 Patrol Robot read-only dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/m20-patrol-robot/current
Environment=PYTHONPATH=%h/m20-patrol-robot/current
Environment=M20_RUNTIME_MODE=realtime_readonly
Environment=M20_READ_ONLY_MODE=true
Environment=M20_CONTROL_ENABLED=false
Environment=M20_TELEMETRY_TX_ENABLED=false
Environment=M20_TARGET_HOST=@AOS_HOST@
Environment=M20_TARGET_PORT=@AOS_TCP_PORT@
Environment=M20_TELEMETRY_RX_ENABLED=true
Environment=M20_WEB_REALTIME_ENABLED=true
Environment=M20_STALE_AFTER_SECONDS=@STALE_AFTER_SECONDS@
ExecStart=%h/m20-patrol-robot/current/.venv/bin/python -c 'from backend.app.dashboard_realtime import serve_dashboard; serve_dashboard(host="@GOS_HOST@", port=@WEB_PORT@, aos_host="@AOS_HOST@", runtime_mode="realtime_readonly", read_only_mode=True, control_enabled=False, telemetry_tx_enabled=False, telemetry_receive_enabled=True, stale_after_s=@STALE_AFTER_SECONDS@)'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/m20-patrol-robot
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
